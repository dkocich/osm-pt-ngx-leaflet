{
  "name": "osm-pt-ngx-leaflet",
  "version": "22.4.29",
  "engines": {
    "node": "22"
  },
  "description": "An OpenStreetMap public transport editor built with Leaflet and Angular.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkocich/osm-pt-ngx-leaflet.git"
  },
  "keywords": [
    "angular",
    "leaflet",
    "openstreetmap",
    "public transport"
  ],
  "author": "David Kocich <dkocich@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dkocich/osm-pt-ngx-leaflet/issues"
  },
  "scripts": {
    "build": "ng build",
    "e2e": "ng e2e",
    "lint": "ng lint",
    "lint:all": "eslint src/**/*.ts src/components/**/*.ts src/*.ts",
    "lint:all:fix": "eslint --fix src/**/*.ts src/components/**/*.ts src/*.ts",
    "lint:fix": "ng lint --fix=true",
    "lint:one-rule-fix": "tslint -c tslint-empty.json src/**/*.ts --fix",
    "lint:navigableInWebstorm": "ng lint --format=stylish",
    "ng": "ng",
    "ngbuild": "ng build --progress --verbose --aot=true --build-optimizer",
    "nge2e": "ng e2e",
    "ngstart-hmr": "ng serve --configuration hmr --hmr --aot=true",
    "snyk-protect": "snyk protect",
    "start": "ng serve --port=4200",
    "stylelint": "stylelint **/*.css **/*.less",
    "test": "ng test",
    "test:all": "snyk test && NODE_ENV=development karma start"
  },
  "homepage": "https://github.com/dkocich/osm-pt-ngx-leaflet#readme",
  "dependencies": {
    "@angular/animations": "~16.2.8",
    "@angular/common": "~16.2.8",
    "@angular/compiler": "~16.2.8",
    "@angular/core": "~16.2.8",
    "@angular/forms": "~16.2.8",
    "@angular/platform-browser": "~16.2.8",
    "@angular/platform-browser-dynamic": "~16.2.8",
    "@angular/router": "~16.2.8",
    "@angularclass/hmr": "3.0.0",
    "@ngx-translate/core": "15.0.0",
    "@ngx-translate/http-loader": "8.0.0",
    "@redux-devtools/extension": "3.2.5",
    "@sentry/browser": "8.33.0",
    "@types/bootstrap": "5.2.6",
    "@types/core-js": "2.5.5",
    "@types/es6-shim": "0.31.42",
    "@types/eslint": "8.44.2",
    "@types/express": "4.17.17",
    "@types/geojson": "7946.0.10",
    "@types/intro.js": "5.1.2",
    "@types/leaflet": "1.9.3",
    "@types/ramda": "0.29.3",
    "@types/redux-logger": "3.0.9",
    "angular2-hotkeys": "15.0.0",
    "angulartics2": "12.2.1",
    "bootstrap": "5.3.2",
    "core-js": "3.32.1",
    "dexie": "3.2.4",
    "express": "4.18.2",
    "flux-standard-action": "2.1.2",
    "font-awesome": "4.7.0",
    "intro.js": "7.2.0",
    "leaflet": "1.9.4",
    "leaflet-textpath": "1.2.3",
    "leaflet.vectorgrid": "1.3.0",
    "mobile-detect": "1.4.5",
    "ng-http-loader": "14.0.0",
    "ng2-dragula": "5.0.1",
    "ngx-bootstrap": "~11.0.2",
    "ngx-toastr": "17.0.2",
    "osm-auth": "2.2.0",
    "osmtogeojson": "3.0.0-beta.5",
    "ramda": "0.29.1",
    "redux": "4.2.1",
    "redux-logger": "3.0.6",
    "reflect-metadata": "0.1.13",
    "rxjs": "~7.8.1",
    "rxjs-compat": "~6.6.7",
    "stylelint": "16.12.0",
    "stylelint-config-standard": "36.0.1",
    "tslib": "2.6.2",
    "xmlbuilder": "15.1.1",
    "zone.js": "~0.13.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~16.2.5",
    "@angular-eslint/builder": "19.0.2",
    "@angular-eslint/eslint-plugin": "19.0.2",
    "@angular-eslint/eslint-plugin-template": "19.0.2",
    "@angular-eslint/schematics": "19.0.2",
    "@angular-eslint/template-parser": "19.0.2",
    "@angular/cli": "~16.2.5",
    "@angular/compiler-cli": "~16.2.8",
    "@angular/language-service": "~16.2.8",
    "@types/jasmine": "~4.3.5",
    "@types/jasminewd2": "~2.0.10",
    "@types/karma": "6.3.4",
    "@types/karma-chrome-launcher": "3.1.1",
    "@types/karma-coverage-istanbul-reporter": "2.1.1",
    "@types/karma-jasmine": "4.0.2",
    "@types/karma-jasmine-html-reporter": "1.7.0",
    "@types/node": "20.5.1",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.28.1",
    "eslint-plugin-jsdoc": "46.5.0",
    "eslint-plugin-prettier": "5.0.0",
    "ts-node": "~10.9.1",
    "typescript": "~5.1.6"
  }
}
