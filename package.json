{
  "name": "osm-pt-ngx-leaflet",
  "version": "22.4.29",
  "engines": {
    "node": "22"
  },
  "description": "An OpenStreetMap public transport editor built with Leaflet and Angular.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkocich/osm-pt-ngx-leaflet.git"
  },
  "keywords": [
    "angular",
    "leaflet",
    "openstreetmap",
    "public transport"
  ],
  "author": "David Kocich <dkocich@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dkocich/osm-pt-ngx-leaflet/issues"
  },
  "scripts": {
    "build": "ng build",
    "e2e": "ng e2e",
    "lint": "ng lint",
    "lint:all": "eslint src/**/*.ts src/components/**/*.ts src/*.ts",
    "lint:all:fix": "eslint --fix src/**/*.ts src/components/**/*.ts src/*.ts",
    "lint:fix": "ng lint --fix=true",
    "lint:one-rule-fix": "tslint -c tslint-empty.json src/**/*.ts --fix",
    "lint:navigableInWebstorm": "ng lint --format=stylish",
    "ng": "ng",
    "ngbuild": "ng build --progress --verbose --aot=true --build-optimizer",
    "nge2e": "ng e2e",
    "ngstart-hmr": "ng serve --configuration hmr --hmr --aot=true",
    "snyk-protect": "snyk protect",
    "start": "ng serve --port=4200",
    "stylelint": "stylelint **/*.css **/*.less",
    "test": "ng test",
    "test:all": "snyk test && NODE_ENV=development karma start"
  },
  "homepage": "https://github.com/dkocich/osm-pt-ngx-leaflet#readme",
  "dependencies": {
    "@angular/animations": "20.0.5",
    "@angular/common": "20.0.5",
    "@angular/compiler": "20.0.5",
    "@angular/core": "20.0.5",
    "@angular/forms": "20.0.5",
    "@angular/platform-browser": "20.0.5",
    "@angular/platform-browser-dynamic": "20.0.5",
    "@angular/router": "20.0.5",
    "@angularclass/hmr": "3.0.0",
    "@ngx-translate/core": "16.0.4",
    "@ngx-translate/http-loader": "16.0.1",
    "@redux-devtools/extension": "3.3.0",
    "@sentry/browser": "9.34.0",
    "@types/bootstrap": "5.2.10",
    "@types/core-js": "2.5.8",
    "@types/es6-shim": "0.31.45",
    "@types/eslint": "9.6.1",
    "@types/express": "5.0.3",
    "@types/geojson": "7946.0.16",
    "@types/intro.js": "5.1.5",
    "@types/leaflet": "1.9.19",
    "@types/ramda": "0.30.2",
    "@types/redux-logger": "3.0.13",
    "angular2-hotkeys": "16.0.1",
    "angulartics2": "14.1.0",
    "bootstrap": "5.3.7",
    "core-js": "3.43.0",
    "dexie": "4.0.11",
    "express": "5.1.0",
    "flux-standard-action": "2.1.2",
    "font-awesome": "4.7.0",
    "intro.js": "7.2.0",
    "leaflet": "1.9.4",
    "leaflet-textpath": "1.3.0",
    "leaflet.vectorgrid": "1.3.0",
    "mobile-detect": "1.4.5",
    "ng-http-loader": "18.0.0",
    "ngx-bootstrap": "~19.0.2",
    "ngx-toastr": "19.0.0",
    "osm-auth": "2.6.0",
    "osmtogeojson": "3.0.0-beta.5",
    "ramda": "0.31.3",
    "redux": "5.0.1",
    "redux-logger": "3.0.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "~7.8.2",
    "rxjs-compat": "~6.6.7",
    "stylelint": "16.21.0",
    "stylelint-config-standard": "38.0.0",
    "tslib": "2.8.1",
    "xmlbuilder": "15.1.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.4",
    "@angular-eslint/builder": "20.1.1",
    "@angular-eslint/eslint-plugin": "20.1.1",
    "@angular-eslint/eslint-plugin-template": "20.1.1",
    "@angular-eslint/schematics": "20.1.1",
    "@angular-eslint/template-parser": "20.1.1",
    "@angular/cli": "^20.0.4",
    "@angular/compiler-cli": "20.0.5",
    "@angular/language-service": "20.0.5",
    "@types/jasmine": "~5.1.8",
    "@types/jasminewd2": "~2.0.13",
    "@types/karma": "6.3.9",
    "@types/karma-chrome-launcher": "3.1.4",
    "@types/karma-coverage-istanbul-reporter": "2.1.4",
    "@types/karma-jasmine": "4.0.5",
    "@types/karma-jasmine-html-reporter": "1.7.3",
    "@types/node": "24.0.8",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "51.3.1",
    "eslint-plugin-prettier": "5.5.1",
    "ts-node": "~10.9.2",
    "typescript": "5.8.3"
  }
}
